from launch import LaunchDescription
from launch_ros.actions import Node

def generate_launch_description():
    return LaunchDescription([
        Node(
            package='warehouse_aisle_patrol',
            executable='teleop',
            name='teleop',
            output='screen',
            parameters=[
                {'waypoints': [
                    {'x': 0.0, 'y': 0.0},
                    {'x': 0.0, 'y': 8.0},
                    {'x': 1.5, 'y': 8.0},
                    {'x': 1.5, 'y': 0.0},
                    {'x': 0.0, 'y': 0.0}
                ]}
            ]
        ),
    ])
